<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <OutputType>Library</OutputType>
    <LangVersion>preview</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <DebugType>embedded</DebugType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!--
      Adjust these paths to point to your Slime Rancher 2 + MelonLoader + MelonSRML installation.
      Typical Steam location: C:\Program Files (x86)\Steam\steamapps\common\Slime Rancher 2
      The interop assemblies are generated by MelonLoader on first launch under MelonLoader\Il2CppAssemblies
    -->
    <GameDir>C:\Program Files (x86)\Steam\steamapps\common\Slime Rancher 2</GameDir>
    <MelonDir>$(GameDir)\MelonLoader</MelonDir>
    <InteropDir>$(MelonDir)\Il2CppAssemblies</InteropDir>
    <MelonSRMLDir>$(GameDir)\Mods</MelonSRMLDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- MelonLoader core -->
    <Reference Include="MelonLoader">
      <HintPath>$(MelonDir)\MelonLoader.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(MelonDir)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- Il2Cpp interop -->
    <Reference Include="Il2CppInterop.Runtime">
      <HintPath>$(MelonDir)\Il2CppInterop.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppInterop.Common">
      <HintPath>$(MelonDir)\Il2CppInterop.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- Game assemblies (IL2CPP interop, generated on first MelonLoader launch) -->
    <Reference Include="Assembly-CSharp">
      <HintPath>$(InteropDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(InteropDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AssetBundleModule">
      <HintPath>$(InteropDir)\UnityEngine.AssetBundleModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(InteropDir)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(InteropDir)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.Localization">
      <HintPath>$(InteropDir)\Unity.Localization.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.InputSystem">
      <HintPath>$(InteropDir)\Unity.InputSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- MelonSRML (mSRML) — install it as a mod first -->
    <Reference Include="MelonSRML">
      <HintPath>$(MelonSRMLDir)\MelonSRML.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Main.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
  </ItemGroup>
</Project>
